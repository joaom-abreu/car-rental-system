@startuml pacotes
title Sistema de Aluguel de Carros — Diagrama de Pacotes (v1)
left to right direction
skinparam shadowing false
skinparam defaultFontSize 14
skinparam packageStyle folder
skinparam nodesep 50
skinparam ranksep 60

package "Construção dinâmica das páginas\n(frontend — React + Vite)" as frontend <<subsistema>> {
  package pages
  package components
  package contexts
  package services
}

package "Gestão de pedidos e contratos\n(backend — Spring Boot)" as backend <<subsistema>> {
  package controller
  package dto
  package service
  package exception
  package security
  package config
  package repository
  package model
}

database "Supabase\n(PostgreSQL)" as supabase

pages ..> components
pages ..> contexts
pages ..> services
components ..> contexts
contexts ..> services

services ..> controller : HTTP/JSON

controller ..> service
controller ..> dto
service ..> repository
service ..> model
service ..> dto
service ..> exception
security ..> repository
security ..> exception
config ..> repository
repository ..> model

repository ..> supabase : JDBC
@enduml
