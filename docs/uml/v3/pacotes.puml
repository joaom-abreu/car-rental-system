@startuml pacotes
title Sistema de Aluguel de Carros — Diagrama de Pacotes (v3)
left to right direction
skinparam shadowing false
skinparam defaultFontSize 14
skinparam packageStyle folder
skinparam nodesep 40
skinparam ranksep 60

package "Construção dinâmica das páginas\n(frontend — React + Vite)" as frontend <<subsistema>> {
  package pages
  package components
  package hooks
  package contexts
  package services
  package frontend.config
  package constants
  package utils
  package styles
}

package "Gestão de pedidos e contratos\n(backend — Spring Boot)" as backend <<subsistema>> {
  package controller
  package dto
  package service
  package security
  package backend.config
  package exception
  package repository
  package model
}

database "Supabase\n(PostgreSQL)" as supabase

pages ..> components
pages ..> hooks
pages ..> services
pages ..> constants
pages ..> utils
pages ..> styles : tokens
components ..> hooks
components ..> constants
components ..> utils
components ..> styles : tokens
hooks ..> contexts
hooks ..> services
hooks ..> constants
contexts ..> services
services ..> frontend.config
services ..> constants

services ..> controller : HTTP/JSON

controller ..> service
controller ..> dto
controller ..> model
service ..> repository
service ..> model
service ..> dto
service ..> exception
service ..> security
dto ..> model
model ..> exception
security ..> repository
security ..> model
security ..> exception
backend.config ..> repository
backend.config ..> model
repository ..> model

repository ..> supabase : JDBC
@enduml
